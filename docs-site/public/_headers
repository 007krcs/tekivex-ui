# Cloudflare Pages + Netlify both honour _headers files.
# Defines security headers + cache policy for the docs site.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'none'

# Aggressive caching for hashed asset bundles
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Soft caching for HTML so deploys propagate fast
/*.html
  Cache-Control: public, max-age=0, must-revalidate
