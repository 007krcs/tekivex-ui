{
  "name": "tekivex-ui",
  "version": "2.8.0",
  "description": "Production-grade React component library — 70+ components, WCAG 2.1 AAA, WAI-ARIA 1.2, built-in charts, headless primitives, zero-runtime CSS engine, TypeScript-first.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/style.css",
    "./themes": {
      "import": "./dist/themes.js",
      "require": "./dist/themes.cjs",
      "types": "./dist/themes.d.ts"
    },
    "./charts": {
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs",
      "types": "./dist/charts.d.ts"
    },
    "./headless": {
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs",
      "types": "./dist/headless.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n.js",
      "require": "./dist/i18n.cjs",
      "types": "./dist/i18n.d.ts"
    },
    "./quantum": {
      "import": "./dist/quantum.js",
      "require": "./dist/quantum.cjs",
      "types": "./dist/quantum.d.ts"
    },
    "./realtime": {
      "import": "./dist/realtime.js",
      "require": "./dist/realtime.cjs",
      "types": "./dist/realtime.d.ts"
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "css:build": "node scripts/css-build.mjs",
    "build:demo": "vite build --config ./demo/vite.config.ts",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run",
    "metrics:collect": "node scripts/collect-metrics.mjs",
    "figma:build": "node packages/figma-kit/scripts/export-tokens.mjs && node packages/figma-kit/scripts/build-variant-catalog.mjs",
    "verify:zero-deps": "node scripts/verify-zero-deps.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "dev:demo": "vite --config ./demo/vite.config.ts",
    "test:visual": "playwright test",
    "test:bundlers": "node scripts/test-bundlers.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "recharts": ">=2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "react",
    "component-library",
    "ui-library",
    "design-system",
    "wcag",
    "accessibility",
    "a11y",
    "aria",
    "wai-aria",
    "security",
    "xss-protection",
    "typescript",
    "tailwind-alternative",
    "css-in-js",
    "headless",
    "charts",
    "recharts",
    "data-grid",
    "form",
    "validation",
    "dark-mode",
    "rtl",
    "i18n",
    "animation",
    "tekivex",
    "enterprise",
    "zero-runtime",
    "react-19",
    "react-server-components",
    "rsc",
    "vite",
    "nextjs",
    "remix",
    "webpack",
    "atomic-css"
  ],
  "author": {
    "name": "007krcs",
    "url": "https://github.com/007krcs"
  },
  "license": "MIT",
  "homepage": "https://ui.tekivex.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/tekivex-ui.git"
  },
  "bugs": {
    "url": "https://github.com/007krcs/tekivex-ui/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/007krcs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
