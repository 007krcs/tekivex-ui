{
  "name": "tekivex-ui",
  "version": "4.5.0",
  "description": "Production-grade React component library — 116 components (plus 4 experimental, opt-in), WCAG 2.1 AA with WAI-ARIA APG patterns, built-in security kernel with published threat model, built-in charts, headless primitives, zero-runtime CSS engine, 44-locale i18n, Indian KYC pack, agent runtime (Anthropic/OpenAI/Gemini/Ollama/MCP/A2A), TypeScript-first.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/tekivex-ui.css",
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./quantum": {
      "import": {
        "types": "./dist/quantum.d.ts",
        "default": "./dist/quantum.js"
      },
      "require": {
        "types": "./dist/quantum.d.cts",
        "default": "./dist/quantum.cjs"
      }
    },
    "./realtime": {
      "import": {
        "types": "./dist/realtime.d.ts",
        "default": "./dist/realtime.js"
      },
      "require": {
        "types": "./dist/realtime.d.cts",
        "default": "./dist/realtime.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent.d.ts",
        "default": "./dist/agent.js"
      },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    },
    "./experimental": {
      "import": {
        "types": "./dist/experimental.d.ts",
        "default": "./dist/experimental.js"
      },
      "require": {
        "types": "./dist/experimental.d.cts",
        "default": "./dist/experimental.cjs"
      }
    },
    "./a11y-aria": {
      "import": {
        "types": "./dist/a11y-aria.d.ts",
        "default": "./dist/a11y-aria.js"
      },
      "require": {
        "types": "./dist/a11y-aria.d.cts",
        "default": "./dist/a11y-aria.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/tekivex-ui.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "scripts": {
    "build": "node scripts/build-all-entries.mjs && tsc --emitDeclarationOnly && node scripts/fix-dts-specifiers.mjs && node scripts/emit-dts-shims.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "partner:add": "node scripts/add-partner.mjs",
    "verify:security-artifacts": "node scripts/verify-security-artifacts.mjs",
    "css:build": "node scripts/css-build.mjs",
    "build:demo": "node scripts/build-unified-site.mjs",
    "build:demo:standalone": "vite build --config ./demo/vite.config.ts",
    "build:unified": "node scripts/build-unified-site.mjs",
    "prepublishOnly": "npm run mcp:catalog && npm run build && npm run check:exports && npm run check:types",
    "pack:check": "npm pack --dry-run",
    "metrics:collect": "node scripts/collect-metrics.mjs",
    "figma:build": "node packages/figma-kit/scripts/export-tokens.mjs && node packages/figma-kit/scripts/build-variant-catalog.mjs",
    "verify:zero-deps": "node scripts/verify-zero-deps.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "dev:demo": "vite --config ./demo/vite.config.ts",
    "test:visual": "playwright test",
    "test:visual:landing": "playwright test -c playwright.landing.config.ts",
    "test:bundlers": "node scripts/test-bundlers.mjs",
    "test:nextjs": "node scripts/test-nextjs-rsc.mjs",
    "aria:sweep": "node scripts/aria.mjs sweep",
    "aria:check": "node scripts/aria.mjs check",
    "aria:report": "node scripts/aria-report.mjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "mcp:catalog": "node scripts/generate-mcp-catalog.mjs",
    "check:exports": "publint",
    "check:types": "attw --pack . --profile node16 --exclude-entrypoints styles",
    "check:pack": "npm run check:exports && npm run check:types"
  },
  "publishConfig": {
    "access": "public"
  },
  "//publishConfig-note": "Provenance attestation is enabled at publish time via `npm publish --provenance` from CI (GitHub Actions OIDC). Setting `provenance: true` here unconditionally blocks local publishes because npm cannot generate the attestation without a supported provider. See .github/workflows/release.yml.",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "recharts": ">=2.0.0 || >=3.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "publint": "^0.3.24",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "react",
    "component-library",
    "ui-library",
    "design-system",
    "wcag",
    "accessibility",
    "a11y",
    "aria",
    "wai-aria",
    "security",
    "xss-protection",
    "typescript",
    "tailwind-alternative",
    "css-in-js",
    "headless",
    "charts",
    "recharts",
    "data-grid",
    "form",
    "validation",
    "dark-mode",
    "rtl",
    "i18n",
    "animation",
    "tekivex",
    "enterprise",
    "zero-runtime",
    "react-19",
    "react-server-components",
    "rsc",
    "vite",
    "nextjs",
    "remix",
    "webpack",
    "atomic-css"
  ],
  "author": {
    "name": "007krcs"
  },
  "license": "MIT",
  "homepage": "https://ui.tekivex.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/007krcs/tekivex-ui.git"
  },
  "bugs": {
    "url": "https://github.com/007krcs/tekivex-ui/issues"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "bin": {
    "tekivex-mcp": "./bin/tekivex-mcp.mjs"
  }
}
