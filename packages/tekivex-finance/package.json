{
  "name": "tekivex-finance",
  "version": "0.1.2",
  "description": "Finance-vertical component pack — KYC inputs, currency formatting, OTP flows, subscription/billing UI, statement viewer primitives.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "tekivex-ui": ">=2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tekivex",
    "finance",
    "kyc",
    "billing",
    "subscription",
    "currency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/novaai0401-ui/tekivex-issue-report.git"
  },
  "bugs": {
    "url": "https://github.com/novaai0401-ui/tekivex-issue-report/issues"
  },
  "homepage": "https://ui.tekivex.com/"
}
