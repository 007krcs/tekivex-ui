{
  "name": "tekivex-pdf",
  "version": "0.1.1",
  "description": "TekiVex PDF — render React components to pixel-stable PDFs and PNGs without a headless browser. Wraps @react-pdf/renderer with the tekivex-ui design system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./raster": {
      "import": "./dist/raster.js",
      "types": "./dist/raster.d.ts"
    },
    "./fonts": {
      "import": "./dist/fonts.js",
      "types": "./dist/fonts.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke-test.mjs"
  },
  "peerDependencies": {
    "@react-pdf/renderer": ">=4.0.0",
    "react": ">=18.0.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tekivex",
    "react-pdf",
    "pdf",
    "react-to-pdf",
    "puppeteer-alternative",
    "biodata",
    "invoice",
    "certificate",
    "resume",
    "ticket",
    "watermark"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/tekivex-ui.git",
    "directory": "packages/tekivex-pdf"
  },
  "bugs": {
    "url": "https://github.com/007krcs/tekivex-ui/issues"
  },
  "homepage": "https://ui.tekivex.com/pdf/",
  "engines": {
    "node": ">=18.0.0"
  }
}
