{
  "name": "tekivex-india",
  "version": "0.1.2",
  "description": "India-specific component pack for tekivex-ui — Aadhaar/PAN/Voter ID/DL inputs, PIN-code address lookup, Indian rupee with lakh/crore grouping, Tithi/Nakshatra calendar.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "tekivex-ui": ">=2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tekivex",
    "india",
    "aadhaar",
    "pan",
    "voter-id",
    "driving-licence",
    "pin-code",
    "rupee",
    "tithi",
    "nakshatra"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/tekivex-ui.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/007krcs/tekivex-ui/issues"
  },
  "homepage": "https://www.tekivex.com/ui/"
}
