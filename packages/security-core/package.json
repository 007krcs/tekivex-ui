{
  "name": "tekivex-security-core",
  "version": "0.1.2",
  "description": "Security kernel for web apps — XSS, Unicode Trojan Source, CSP, PII, clickjacking, rate-limit, MIME-sniff defenses. Framework-agnostic. Pure TypeScript, zero runtime deps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THREAT-MODEL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "security",
    "xss",
    "csp",
    "sanitize",
    "sanitization",
    "trojan-source",
    "cve-2021-42574",
    "clickjacking",
    "rate-limit",
    "pii",
    "owasp",
    "cwe",
    "zero-trust",
    "typescript"
  ],
  "author": "tekivex-ui contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/novaai0401-ui/tekivex-issue-report.git"
  },
  "homepage": "https://ui.tekivex.com/",
  "bugs": {
    "url": "https://github.com/novaai0401-ui/tekivex-issue-report/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
