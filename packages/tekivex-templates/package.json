{
  "name": "tekivex-templates",
  "version": "0.1.1",
  "description": "Pre-built PDF templates — Biodata, Invoice, Certificate, Resume, Ticket, Boarding Pass, Receipt — built on tekivex-pdf. Drop in, render, ship.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./biodata": {
      "import": "./dist/biodata.js",
      "types": "./dist/biodata.d.ts"
    },
    "./invoice": {
      "import": "./dist/invoice.js",
      "types": "./dist/invoice.d.ts"
    },
    "./certificate": {
      "import": "./dist/certificate.js",
      "types": "./dist/certificate.d.ts"
    },
    "./resume": {
      "import": "./dist/resume.js",
      "types": "./dist/resume.d.ts"
    },
    "./ticket": {
      "import": "./dist/ticket.js",
      "types": "./dist/ticket.d.ts"
    },
    "./boarding-pass": {
      "import": "./dist/boardingPass.js",
      "types": "./dist/boardingPass.d.ts"
    },
    "./receipt": {
      "import": "./dist/receipt.js",
      "types": "./dist/receipt.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node fix-esm-imports.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@react-pdf/renderer": ">=4.0.0",
    "react": ">=18.0.0",
    "tekivex-pdf": ">=0.3.0"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "tekivex-pdf": "^0.1.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tekivex",
    "react-pdf",
    "pdf-templates",
    "biodata",
    "invoice",
    "certificate",
    "resume",
    "ticket",
    "boarding-pass",
    "receipt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/007krcs/tekivex-ui.git",
    "directory": "packages/tekivex-templates"
  },
  "homepage": "https://ui.tekivex.com/pdf/templates/",
  "engines": {
    "node": ">=18.0.0"
  }
}
